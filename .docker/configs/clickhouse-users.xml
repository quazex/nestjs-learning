<?xml version="1.0"?>
<clickhouse>
    <profiles>
        <default>
            <allow_experimental_object_type>1</allow_experimental_object_type>
            <output_format_json_named_tuples_as_objects>1</output_format_json_named_tuples_as_objects>
            <output_format_json_quote_64bit_integers>0</output_format_json_quote_64bit_integers>
            <enable_http_compression>1</enable_http_compression>
            <union_default_mode>ALL</union_default_mode>
            <max_memory_usage>4294967296</max_memory_usage>
        </default>
    </profiles>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>

    <users>
        <quazex>
            <password>quazex</password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
        </quazex>
    </users>
</clickhouse>
