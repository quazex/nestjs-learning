        "@testcontainers/mongodb": "10.24.2",
        "@types/luxon": "3.4.2",
        "@types/stream-json": "1.7.8",
        "@types/unzipper": "0.10.10",
        "axios": "1.7.7",
        "csv-parse": "5.6.0",
        "csv-stringify": "6.5.2",
        "jest": "29.7.0",
        "luxon": "3.6.1",
        "mongodb": "6.15.0",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.0.1",
        "rxjs": "7.8.2",
        "stream-json": "1.9.1",
