{
    "name": "@quazex/nestjs-graphql",
    "description": "NestJS integration with GraphQL",
    "version": "1.0.0",
    "author": "Alexander Smirnov",
    "dependencies": {
        "@as-integrations/fastify": "2.1.1",
        "@apollo/server": "4.12.1",
        "@nestjs/apollo": "12.2.2",
        "@nestjs/common": "10.4.15",
        "@nestjs/core": "10.4.15",
        "@nestjs/graphql": "12.2.2",
        "@nestjs/platform-fastify": "10.4.15",
        "@mikro-orm/core": "6.4.15",
        "@mikro-orm/nestjs": "6.1.1",
        "@mikro-orm/postgresql": "6.4.15",
        "class-validator": "0.14.1",
        "dotenv": "16.5.0",
        "env-var": "7.5.0",
        "graphql": "16.11.0",
        "luxon": "3.6.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2"
    },
    "devDependencies": {
        "@faker-js/faker": "9.8.0",
        "@jest/globals": "29.7.0",
        "@nestjs/testing": "10.4.15",
        "@quazex/eslint-config": "1.0.3",
        "@types/luxon": "3.6.2",
        "jest": "29.7.0",
        "rimraf": "6.0.1",
        "ts-jest": "29.3.4",
        "ts-node": "10.9.2",
        "type-fest": "4.41.0",
        "typescript": "5.4.5"
    },
    "keywords": [
        "graphql",
        "nest",
        "nestjs",
        "node",
        "nodejs",
        "typescript"
    ],
    "scripts": {
        "build:clear": "rimraf lib",
        "build:compile": "npm run build:clear && tsc --project tsconfig.build.json",
        "commit": "git-cz",
        "dev:check": "tsc --noEmit",
        "dev:format": "npm run dev:lint -- --fix",
        "dev:lint": "eslint ./source --ext .ts",
        "dev:test": "jest",
        "dev:watch": "nest start --watch"
