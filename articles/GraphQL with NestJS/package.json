        "@nestjs/graphql": "12.2.2",
        "@nestjs/platform-express": "10.4.15",
        "@nestjs/testing": "10.4.15",
        "@quazex/eslint-config": "1.0.3",
        "@types/luxon": "3.4.2",
        "class-validator": "0.14.1",
        "class-transformer": "0.5.1",
        "commitizen": "4.3.1",
        "cz-conventional-changelog": "3.3.0",
        "env-var": "7.5.0",
        "dotenv": "16.5.0",
        "graphql": "16.11.0",
        "jest": "29.7.0",
        "luxon": "3.5.0",
